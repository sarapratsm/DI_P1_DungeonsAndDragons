            <TabItem Header="Personal Info">
                <DockPanel Margin="10">
                    <Label DockPanel.Dock="Top" Style="{StaticResource DnDSubSectionTitle}" Content="Personal info" Margin="10,10,10,0"/>
                    <Label DockPanel.Dock="Top" Content="Complete personal information: " Margin="10,0,10,10"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" VerticalAlignment="Top" Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Name (*):" VerticalAlignment="Center"      Margin="10" HorizontalAlignment="Right"/>
                                <Label Grid.Row="1" Grid.Column="0" Content="Height (*):" VerticalAlignment="Center"    Margin="10" HorizontalAlignment="Right"/>
                                <Label Grid.Row="2" Grid.Column="0" Content="Weight (*):" VerticalAlignment="Center"    Margin="10" HorizontalAlignment="Right"/>
                                <Label Grid.Row="3" Grid.Column="0" Content="Age (*):" VerticalAlignment="Center"       Margin="10" HorizontalAlignment="Right"/>

                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtName" Margin="5" VerticalContentAlignment="Center" Padding="5,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtHeight" Margin="5" VerticalContentAlignment="Center" Padding="5,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtWeight" Margin="5" VerticalContentAlignment="Center" Padding="5,0"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtAge" Margin="5" VerticalContentAlignment="Center" Padding="5,0"/>

                                <Label Grid.Row="4" Grid.Column="0" Content="Alignment:" VerticalAlignment="Center" Margin="5" HorizontalAlignment="Right"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="cmbAlignment" DisplayMemberPath="Name" Margin="5" VerticalContentAlignment="Center" Padding="5,0"/>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="0,0,20,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Label Content="Photo (*):" HorizontalAlignment="Left" Margin="5"/>
                                <Border BorderBrush="Gray" BorderThickness="1" Width="250" Height="250" Margin="5" Background="#e0dccc">
                                    <Image x:Name="imgPhotoPreview" Stretch="UniformToFill"/>
                                </Border>
                                <Button x:Name="btnUpload" Content="Upload" Width="120" Margin="5" Padding="5" HorizontalAlignment="Center" Click="btnUpload_Click"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                </DockPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
