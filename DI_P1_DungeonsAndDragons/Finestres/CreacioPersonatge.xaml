<Window x:Class="DI_P1_DungeonsAndDragons.CreacioPersonatge"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DI_P1_DungeonsAndDragons"
        xmlns:view="clr-namespace:DI_P1_DungeonsAndDragons.View"
        mc:Ignorable="d"
        Background="#f5ebd3"
        WindowState="Maximized"
        Closed="Window_Closed"
        Loaded="Window_Loaded"
        Title="CreacioPersonatge" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="8*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Image x:Name="imgLogo" Source="/img/logodnd.png" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top"></Image>
        <Label Content="Character Editor" Margin="0,20,0,0" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="0" Style="{StaticResource DnDMiniTitleStyle}" Grid.RowSpan="2"/>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>


            <!--Margin="Left,Top,Right,Bottom"-->
            <Button x:Name="btnCancel" Grid.Column="0" Margin="10,0,0,0" Style="{StaticResource IconButtonStyle}" Click="btnCancel_Click">&#xF78A;</Button>
            <Button x:Name="btnSave"   Grid.Column="1" Margin="0,0,50,0" Style="{StaticResource IconButtonStyle}" Click="btnSave_Click">&#xE74E;</Button>
        </Grid>
        <TabControl x:Name="tbcTab" Grid.Column="1" Grid.Row="2" Margin="5,10,50,30" >


            <!--Pestanya de Classes i especie-->
            <TabItem Header="Class and Specie">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10" Style="{StaticResource DnDSubSectionTitle}">Choose a Class</Label>
                    <Label Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10" Style="{StaticResource DnDSubSectionTitle}">Choose a Specie</Label>

                    <!--Vista de les classes-->
                    <ListBox x:Name="lsbClasses"  Grid.Row="1" 
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                             SelectionChanged="lsbClasses_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <view:FitxaClasse TheClasse="{Binding}"></view:FitxaClasse>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <!--Vista de les especies-->
                    <ListBox x:Name="lsbSpecies"  Grid.Row="4" ScrollViewer.VerticalScrollBarVisibility="Auto" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                             SelectionChanged="lsbSpecies_SelectionChanged" >
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <view:FitxaSpecie TheSpecies="{Binding}"></view:FitxaSpecie>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!--Habilitats-->
            <TabItem Header="Abilities">
                <DockPanel>
                    <Label DockPanel.Dock="Top" Content="Ability scores" Style="{StaticResource DnDSubSectionTitle}" 
                           Margin="10"/>

                    <Label DockPanel.Dock="Top" Content="Assign the 6 ability scores..." Margin="10,0"/>

                    <Grid DockPanel.Dock="Bottom" Margin="20,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Grid.Row="0" Content="Class Skills" Style="{StaticResource DnDSubSectionTitle}" 
                               Margin="10"/>
                        <TextBox Name="lblSkills" Grid.Column="0" Grid.Row="1" Text="Choose 2:" HorizontalAlignment="Center" Focusable="true" IsReadOnly="True" BorderThickness="0"/>
                        <ComboBox x:Name="cmbClassSkill1" Grid.Column="1" Grid.Row="1" SelectionChanged="cmbClassSkill1_SelectionChanged"/>
                        <ComboBox x:Name="cmbClassSkill2" Grid.Column="2" Grid.Row="1" SelectionChanged="cmbClassSkill1_SelectionChanged"/>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,10">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="1" Content="Score" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <Label Grid.Row="0" Grid.Column="2" Content="Racial Bonus" FontWeight="Bold" HorizontalAlignment="Center" Margin="10,0"/>
                            <Label Grid.Row="0" Grid.Column="3" Content="Final Score" FontWeight="Bold" HorizontalAlignment="Center" Margin="10,0"/>

                            <Label Content="Strength:" Grid.Row="1" Grid.Column="0" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <view:NumericUpDown ValorChanged="nudStrength_ValorChanged" x:Name="nudStrength" Grid.Row="1" Grid.Column="1" Margin="5" Min="3" Max="15" Valor="8" />
                            <Label Grid.Row="1" Grid.Column="2" x:Name="lblStrengthBonus" Content="+0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Label Grid.Row="1" Grid.Column="3" x:Name="lblStrengthFinal" Content="8 (-1)" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0"/>

                            <Label Content="Dexterity:" Grid.Row="2" Grid.Column="0" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <view:NumericUpDown ValorChanged="nudDexterity_ValorChanged" x:Name="nudDexterity" Grid.Row="2" Grid.Column="1" Margin="5" Min="3" Max="15" Valor="8" />
                            <Label Grid.Row="2" Grid.Column="2" x:Name="lblDexterityBonus" Content="+0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Label Grid.Row="2" Grid.Column="3" x:Name="lblDexterityFinal" Content="8 (-1)" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0"/>

                            <Label Content="Constitution:" Grid.Row="3" Grid.Column="0" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <view:NumericUpDown ValorChanged="nudConstitution_ValorChanged" x:Name="nudConstitution" Grid.Row="3" Grid.Column="1" Margin="5" Min="3" Max="15" Valor="8" />
                            <Label Grid.Row="3" Grid.Column="2" x:Name="lblConstitutionBonus" Content="+0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Label Grid.Row="3" Grid.Column="3" x:Name="lblConstitutionFinal" Content="8 (-1)" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0"/>

                            <Label Content="Intelligence:" Grid.Row="4" Grid.Column="0" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <view:NumericUpDown ValorChanged="nudIntelligence_ValorChanged" x:Name="nudIntelligence" Grid.Row="4" Grid.Column="1" Margin="5" Min="3" Max="15" Valor="8" />
                            <Label Grid.Row="4" Grid.Column="2" x:Name="lblIntelligenceBonus" Content="+0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Label Grid.Row="4" Grid.Column="3" x:Name="lblIntelligenceFinal" Content="8 (-1)" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0"/>

                            <Label Content="Wisdom:" Grid.Row="5" Grid.Column="0" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <view:NumericUpDown ValorChanged="nudWisdom_ValorChanged" x:Name="nudWisdom" Grid.Row="5" Grid.Column="1" Margin="5" Min="3" Max="15" Valor="8" />
                            <Label Grid.Row="5" Grid.Column="2" x:Name="lblWisdomBonus" Content="+0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Label Grid.Row="5" Grid.Column="3" x:Name="lblWisdomFinal" Content="8 (-1)" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0"/>

                            <Label Content="Charisma:" Grid.Row="6" Grid.Column="0" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <view:NumericUpDown ValorChanged="nudCharisma_ValorChanged" x:Name="nudCharisma" Grid.Row="6" Grid.Column="1" Margin="5" Min="3" Max="15" Valor="8" />
                            <Label Grid.Row="6" Grid.Column="2" x:Name="lblCharismaBonus" Content="+0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Label Grid.Row="6" Grid.Column="3" x:Name="lblCharismaFinal" Content="8 (-1)" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0"/>

                            <!--<view:NumericUpDown x:Name="nudStrength" 
                                Valor="{Binding PjAux.PuntsFor, Mode=TwoWay}" 
                                Grid.Row="1" Grid.Column="1" Margin="5" Min="3" Max="15" />

                            <view:NumericUpDown x:Name="nudDexterity" 
                                Valor="{Binding PjAux.PuntsDes, Mode=TwoWay}" 
                                Grid.Row="2" Grid.Column="1" Margin="5" Min="3" Max="15" />

                            <view:NumericUpDown x:Name="nudConstitution" 
                                Valor="{Binding PjAux.PuntsCon, Mode=TwoWay}" 
                                Grid.Row="3" Grid.Column="1" Margin="5" Min="3" Max="15" />

                                <view:NumericUpDown x:Name="nudIntelligence" 
                                    Valor="{Binding PjAux.PuntsInt, Mode=TwoWay}" 
                                    Grid.Row="4" Grid.Column="1" Margin="5" Min="3" Max="15" />

                            <view:NumericUpDown x:Name="nudWisdom" 
                                Valor="{Binding PjAux.PuntsSav, Mode=TwoWay}" 
                                Grid.Row="5" Grid.Column="1" Margin="5" Min="3" Max="15" />

                            <view:NumericUpDown x:Name="nudCharisma" 
                                Valor="{Binding PjAux.PuntsCar, Mode=TwoWay}" 
                                Grid.Row="6" Grid.Column="1" Margin="5" Min="3" Max="15" />-->

                            <TextBox x:Name="lblSpentPoints"  Grid.Row="7" Grid.Column="1" Text="Spent score: 0/27" Focusable="true" IsReadOnly="True" BorderThickness="0" HorizontalAlignment="Center"  FontWeight="Bold"/>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>


            <!--Personal info-->
            <TabItem Header="Personal Info">
                <DockPanel Margin="10">
                    <Label DockPanel.Dock="Top" Style="{StaticResource DnDSubSectionTitle}" Content="Personal info" Margin="10,10,10,0"/>
                    <Label DockPanel.Dock="Top" Content="Complete personal information: " Margin="10,0,10,10"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" VerticalAlignment="Top" Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Name (*):" VerticalAlignment="Center"      Margin="20" HorizontalAlignment="Right"/>
                                <Label Grid.Row="1" Grid.Column="0" Content="Height (*):" VerticalAlignment="Center"    Margin="20" HorizontalAlignment="Right"/>
                                <Label Grid.Row="2" Grid.Column="0" Content="Weight (*):" VerticalAlignment="Center"    Margin="20" HorizontalAlignment="Right"/>
                                <Label Grid.Row="3" Grid.Column="0" Content="Age (*):" VerticalAlignment="Center"       Margin="20" HorizontalAlignment="Right"/>

                                <TextBox  Grid.Row="0" Grid.Column="1" TextChanged="txtName_TextChanged" 
                                            x:Name="txtName" Margin="5" VerticalContentAlignment="Center" Padding="5,0"
                                            Text="{Binding PjAux.Nom, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                <TextBox  Grid.Row="1" Grid.Column="1" TextChanged="txtHeight_TextChanged" 
                                            x:Name="txtHeight" Margin="5" VerticalContentAlignment="Center" Padding="5,0"
                                            Text="{Binding PjAux.Altura, Mode=TwoWay}"/>
                                <TextBox  Grid.Row="2" Grid.Column="1" TextChanged="txtWeight_TextChanged" 
                                            x:Name="txtWeight" Margin="5" VerticalContentAlignment="Center" Padding="5,0"
                                            Text="{Binding PjAux.Pes, Mode=TwoWay}"/>
                                <TextBox  Grid.Row="3" Grid.Column="1" TextChanged="txtAge_TextChanged" 
                                            x:Name="txtAge" Margin="5" VerticalContentAlignment="Center" Padding="5,0"
                                            Text="{Binding PjAux.Edat, Mode=TwoWay}"/>
                                            

                                <Label Grid.Row="4" Grid.Column="0" Content="Alignment:" VerticalAlignment="Center" Margin="5" HorizontalAlignment="Right"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="cmbAlignment" 
                                          DisplayMemberPath="Name" Margin="5" VerticalContentAlignment="Center" Padding="5,0"
                                          SelectedItem="{Binding PjAux.Alignment, Mode=TwoWay}"/>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="0,0,20,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <!--<Border BorderBrush="Gray" BorderThickness="1" Width="250" Height="250" Margin="5" Background="#e0dccc">-->
                                <Border Grid.Column="0" Style="{StaticResource DnDSectionFrame}">
                                    <Image x:Name="imgPhotoPreview" 
                                       Stretch="UniformToFill"
                                       Width="auto" Height="200" 
                                       Source="{Binding PjAux.ImageUrl, RelativeSource={
                                            RelativeSource AncestorType=local:CreacioPersonatge}}"/>
                                </Border>
                                <Label Content="Photo (*)" HorizontalAlignment="Left" Margin="5"/>
                                <Button x:Name="btnUpload" Content="Upload" Width="120" Margin="5" Padding="5" HorizontalAlignment="Center" Click="btnUpload_Click"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                </DockPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
