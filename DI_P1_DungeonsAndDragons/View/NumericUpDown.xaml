<UserControl x:Class="DI_P1_DungeonsAndDragons.View.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DI_P1_DungeonsAndDragons.View"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="150"
             MinHeight="30" MaxHeight="60">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="1.5*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" MaxWidth="60" FontSize="18" Click="btnMenys_Click" x:Name="btnMenys" FontWeight="Bold">-</Button>
        <Button Grid.Column="2" MaxWidth="60" FontSize="18" Click="btnMes_Click" x:Name="btnMes" FontWeight="Bold">+</Button>

        <TextBox x:Name="txtValor" Grid.Column="1" 
                 FontSize="18" 
                 Padding="5,0"
                 TextAlignment="Center" 
                 VerticalAlignment="Stretch" 
                 VerticalContentAlignment="Center" 
                 MaxWidth="200"
                 Text="{Binding RelativeSource={RelativeSource AncestorType=local:NumericUpDown}, Path=Valor}"/>

    </Grid>
</UserControl>