<UserControl x:Class="DI_P1_DungeonsAndDragons.View.FitxaSpecie"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DI_P1_DungeonsAndDragons.View"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="3*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
        </Grid.RowDefinitions>

        <Image x:Name="imgClasse"
               Grid.Column="0" 
               Grid.Row="0"
               Grid.RowSpan="2" Stretch="Uniform"
               Margin="5"
               MaxHeight="100"
               Source="{Binding Path=TheSpecies.ImageUrl, 
                         RelativeSource={RelativeSource AncestorType=local:FitxaSpecie}, 
                         FallbackValue={x:Null}}"/>

        <TextBlock Grid.Column="1" 
                   Grid.Row="0"
                   VerticalAlignment="Bottom"
                   Text="{Binding Path=TheSpecies.Name, 
                             RelativeSource={RelativeSource AncestorType=local:FitxaSpecie}, 
                             FallbackValue='Nombre Especie'}"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="5"/>

        <TextBlock Grid.Column="1" 
                   Grid.Row="1"
                   Text="{Binding Path=TheSpecies.Description, 
                             RelativeSource={RelativeSource AncestorType=local:FitxaSpecie}, 
                             FallbackValue='Descripció de la especie...'}"
                   TextWrapping="Wrap" Margin="5"
                   VerticalAlignment="Top"/>
    </Grid>
</UserControl>
