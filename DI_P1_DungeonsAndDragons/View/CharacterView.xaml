<UserControl x:Class="DI_P1_DungeonsAndDragons.View.CharacterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DI_P1_DungeonsAndDragons.View"
             mc:Ignorable="d" 
             d:DesignHeight="130" d:DesignWidth="450">

    <Border BorderBrush="#B9711A" BorderThickness="2" 
            Background="#FFF8E7" CornerRadius="8" 
            Margin="5" Padding="5">

        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" Opacity="0.2"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="100" Height="100" 
                    CornerRadius="6" BorderBrush="#D2B48C" BorderThickness="1"
                    Margin="5">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding TheCharacter.ImageUrl, RelativeSource={RelativeSource AncestorType=local:CharacterView}, FallbackValue={x:Null}}" 
                                Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">

                <TextBlock Text="{Binding TheCharacter.Nom, RelativeSource={RelativeSource AncestorType=local:CharacterView}, FallbackValue='Character Name'}"
                           FontFamily="{StaticResource DnDFontFamily}"
                           FontSize="22" 
                           FontWeight="Bold"
                           Foreground="#D65E3C"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="{Binding TheCharacter.Species.Name, RelativeSource={RelativeSource AncestorType=local:CharacterView}, FallbackValue='Species'}" 
                               FontSize="15" FontWeight="SemiBold" Foreground="#555"/>

                    <TextBlock Text=" • " FontSize="15" Foreground="#D65E3C" Margin="5,0"/>

                    <TextBlock Text="{Binding TheCharacter.Classe.Name, RelativeSource={RelativeSource AncestorType=local:CharacterView}, FallbackValue='Class'}" 
                               FontSize="15" Foreground="#333"/>
                </StackPanel>

                <TextBlock Text="{Binding TheCharacter.Alignment.Name, RelativeSource={RelativeSource AncestorType=local:CharacterView}, FallbackValue='Alignment'}"
                           FontStyle="Italic" FontSize="13" Foreground="#777" Margin="0,3,0,0"/>
            </StackPanel>

        </Grid>
    </Border>

</UserControl>