<UserControl x:Class="DI_P1_DungeonsAndDragons.View.CharacterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DI_P1_DungeonsAndDragons.View"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="400">

    <Border Grid.Column="1" BorderBrush="#B9711A" BorderThickness="2">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="2*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <!-- Imatge del personatge -->
            <Image x:Name="imgPersonatge"
               Grid.Column="0"
               Grid.Row="0"
               Grid.RowSpan="3"
               Margin="10"
               Stretch="Uniform"
               MaxWidth="150"
               Source="{Binding Path=TheCharacter.ImageUrl,
                                RelativeSource={RelativeSource AncestorType=local:CharacterView},
                                FallbackValue={x:Null}}"/>

            <!-- Nom -->
            <Label x:Name="txbNom"
                   Grid.Column="1"
                   Grid.Row="0"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="10"
                   Style="{StaticResource DnDMiniTitleStyle}"
                   Content="{Binding Path=TheCharacter.Nom,
                                  RelativeSource={RelativeSource AncestorType=local:CharacterView},
                                  FallbackValue='Nom'}"/>

            <!-- Espècie -->
            <TextBlock x:Name="txtSpeciePersonatge"
                   Grid.Column="1"
                   Grid.Row="1"
                   TextWrapping="Wrap"
                   Margin="10"
                   Text="{Binding Path=TheCharacter.Species.Name,
                                  RelativeSource={RelativeSource AncestorType=local:CharacterView},
                                  FallbackValue='Espècie'}"/>

            <!-- Classe -->
            <TextBlock x:Name="txtClassePersonatge"
                   Grid.Column="1"
                   Grid.Row="2"
                   TextWrapping="Wrap"
                   Margin="10"
                   Text="{Binding Path=TheCharacter.Classe.Name,
                                  RelativeSource={RelativeSource AncestorType=local:CharacterView},
                                  FallbackValue='Classe'}"/>
        </Grid>
    </Border>

</UserControl>
